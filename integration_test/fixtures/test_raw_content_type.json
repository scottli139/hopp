{
  "info": {
    "_postman_id": "test-raw-content-type",
    "name": "Test Raw Content Type",
    "description": "Test collection for verifying raw content type mapping",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "JSON Request",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"test\",\n  \"password\": \"123456\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://httpbin.org/post",
          "protocol": "https",
          "host": ["httpbin", "org"],
          "path": ["post"]
        }
      },
      "response": []
    },
    {
      "name": "XML Request",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/xml",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "<user>\n  <name>test</name>\n</user>",
          "options": {
            "raw": {
              "language": "xml"
            }
          }
        },
        "url": {
          "raw": "https://httpbin.org/post",
          "protocol": "https",
          "host": ["httpbin", "org"],
          "path": ["post"]
        }
      },
      "response": []
    },
    {
      "name": "Text Request (no language)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "text/plain",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "Plain text content"
        },
        "url": {
          "raw": "https://httpbin.org/post",
          "protocol": "https",
          "host": ["httpbin", "org"],
          "path": ["post"]
        }
      },
      "response": []
    },
    {
      "name": "JSON Request (from Content-Type header only)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"test\": \"value\"}"
        },
        "url": {
          "raw": "https://httpbin.org/post",
          "protocol": "https",
          "host": ["httpbin", "org"],
          "path": ["post"]
        }
      },
      "response": []
    }
  ]
}
