#!/bin/bash
# pre-push: 与 CI 的 Format check 保持一致，push 前拦截未格式化的代码
#
# 对应 CI 步骤（.github/workflows/ci.yml → analyze-and-test → Format check）:
#   dart format --output=none --set-exit-if-changed lib/ test/
#
# 安装（每个 clone 只需一次）:
#   git config core.hooksPath .githooks

# 优先使用 FVM 锁定的 Flutter SDK 自带的 dart，保证与 CI（FLUTTER_VERSION: 3.27.4）
# 格式化行为一致；不依赖 fvm 在 PATH 中（GUI Git 客户端的 hook 环境通常没有完整 PATH）
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT" || exit 1

DART="$REPO_ROOT/.fvm/flutter_sdk/bin/dart"
if [ ! -x "$DART" ]; then
  if command -v fvm >/dev/null 2>&1; then
    DART="fvm dart"
  elif command -v dart >/dev/null 2>&1; then
    DART="dart"
  else
    echo "[pre-push] 警告: 找不到 dart（.fvm/flutter_sdk、fvm、PATH 均不可用），跳过格式检查" >&2
    exit 0
  fi
fi

echo "[pre-push] dart format 检查 lib/ test/ ..."
if ! $DART format --output=none --set-exit-if-changed lib/ test/; then
  echo "" >&2
  echo "[pre-push] ✗ 格式检查失败（CI 的 Format check 也会失败）" >&2
  echo "[pre-push] 修复: fvm dart format lib/ test/，然后重新 add + commit --amend 再 push" >&2
  exit 1
fi
echo "[pre-push] ✓ 格式检查通过"
exit 0
